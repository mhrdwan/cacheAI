{
  "name": "cacheai-mcp",
  "version": "0.1.0",
  "description": "Persistent memory MCP server for AI agents — remember across sessions, never forget mid-session",
  "type": "module",
  "bin": {
    "cacheai-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "agent",
    "persistent",
    "context"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^9.4.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
